{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "name": "poool",
  "scripts": {
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "p:base": "yarn workspace @poool/eslint-config",
    "p:react": "yarn workspace @poool/eslint-config-react",
    "p:oxfmt": "yarn workspace @poool/oxfmt-config",
    "p:oxlint": "yarn workspace @poool/oxlint-config",
    "clean": "turbo run clean",
    "build": "turbo run build",
    "prepack": "yarn build && yarn lint && yarn tsc && yarn test"
  },
  "devDependencies": {
    "@poool/eslint-config": "workspace:^",
    "@poool/eslint-config-react": "workspace:^",
    "@poool/oxfmt-config": "workspace:^",
    "@swc/core": "1.16.1",
    "@swc/jest": "0.2.39",
    "@types/eslint": "9.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.9.1",
    "eslint-plugin-oxlint": "1.81.0",
    "execa": "10.0.1",
    "jest": "30.5.1",
    "lerna": "10.0.1",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "ts-node": "10.9.2",
    "turbo": "2.10.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
